# Firebase Configuration for LPU Smart Campus Navigator
# Create a Firebase project at https://console.firebase.google.com/
# Enable Authentication (Email/Password & Anonymous) and Cloud Firestore

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps Platform Configuration (Optional / Phase 8 Integration)
# Create a project at https://console.cloud.google.com/
# Enable: Maps JavaScript API, Places API (New), Directions API, Geocoding API
# Restrict key by HTTP referrers: http://localhost:*/* and your GitHub Pages domain
VITE_GOOGLE_MAPS_API_KEY=

# Geoapify Services Configuration (Optional / Secondary Search & Public Fallback Routing)
# Create a project at https://myprojects.geoapify.com/
# Free tier gives 3,000 requests/day. Key is public in Vite builds, so restrict HTTP referrers:
# Allowed domains: https://rounakg834-droid.github.io/*, http://localhost:*, http://127.0.0.1:*
VITE_GEOAPIFY_API_KEY=
